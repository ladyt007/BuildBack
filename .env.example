# Copy this file to `.env` and fill in the values.
# Leave the Supabase values empty to run in preview mode with sample data.

# Supabase: Project Settings -> API
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Where people can email the BuildBack team (shown in the app, Terms and Privacy Policy)
EXPO_PUBLIC_CONTACT_EMAIL=admin@buildback.tech

# Who runs BuildBack, as named in the Terms of Use and Privacy Policy
EXPO_PUBLIC_OPERATOR_NAME=BuildBack

# Your public website address (used in share links)
EXPO_PUBLIC_SITE_URL=https://buildback-community.netlify.app

# Payment links for BuildBack's paid plans (e.g. Stripe Payment Links).
# Leave empty to show a "Contact us" button instead.
EXPO_PUBLIC_LINK_FEATURED=
EXPO_PUBLIC_LINK_PRO=
EXPO_PUBLIC_LINK_SPONSOR=
EXPO_PUBLIC_LINK_SUPPORT_BUILDBACK=
